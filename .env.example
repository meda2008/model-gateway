# ===== 网关自身 =====
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=8317
GATEWAY_DB=./gateway.db
DEFAULT_RPM=60
DEFAULT_DAILY_REQUESTS=2000
REQUEST_TIMEOUT=180
# free/auto 的降级链顺序（逗号分隔，按优先级）
FREE_AUTO_CHAIN=workbuddy,qoder
# 本机回环地址不走代理（Qoder2Api 在 127.0.0.1；外部地址仍走系统代理）
NO_PROXY=127.0.0.1,localhost
no_proxy=127.0.0.1,localhost

# ===== WorkBuddy 云服务（激活云服务后，从 publicConfig 复制）=====
# 形如 https://<你的应用发布域名>.workbuddy.link
WB_ENDPOINT=
# wbpk_ 开头
WB_PUBLISHABLE_KEY=
# 服务端校验 Origin 与应用发布域名一致；默认取 WB_ENDPOINT 的 origin，
# 若服务端报 auth_ 类错误再手动指定为应用发布域名（scheme://host）
WB_ORIGIN=
# 可选：静态模型 id 列表（不填则启动时自动拉取 /.cloud/llm/models）
WB_MODELS=
# free/auto 链上 WorkBuddy 侧使用的模型 id（激活后从 /v1/models 看）
WB_DEFAULT_MODEL=auto
# WB 要求 messages[0] 为 system；调用方没带时注入此默认值
WB_DEFAULT_SYSTEM=You are a helpful assistant. Be concise and helpful.

# ===== Qoder（direct=内嵌直连，单进程，推荐；proxy=独立 Qoder2Api 进程）=====
QODER_MODE=direct
# 以下仅 QODER_MODE=proxy 时生效；直连模式用设备登录 token（~/.qoder2api-auth.json），
# 重新登录：python -m gateway qoder-login
# QODER_BASE_URL=http://127.0.0.1:61025/v1
# 必须与 Qoder2Api 启动时的 --api-key 一致
# QODER_API_KEY=sk-qoder-local
QODER_MODELS=qwen3.8-flash
QODER_DEFAULT_MODEL=qwen3.8-flash
